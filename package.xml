<?xml version="1.0"?>
<package format="3">
  <name>neupan_controller</name>
  <version>0.1.0</version>
  <description>NeuPAN controller plugin for Nav2 — NRMP optimization-based local planner for differential drive robots.</description>

  <maintainer email="nelsenedbert@gmail.com">Nelsen Edbert Winata</maintainer>
  <author>Nelsen Edbert Winata</author>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
